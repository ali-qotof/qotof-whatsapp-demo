# انسخ الملف إلى .env وغيّر كل القيم قبل التشغيل
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=crm.example.com
CSRF_TRUSTED_ORIGINS=https://crm.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
APP_DOMAIN=crm.example.com
LOG_LEVEL=INFO

POSTGRES_DB=qotof_crm
POSTGRES_USER=qotof
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# اترك المحاكاة مفعلة حتى ينجح اختبار Meta على الرقم التجريبي
WHATSAPP_SIMULATION_MODE=1
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
